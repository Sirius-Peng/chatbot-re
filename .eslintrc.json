{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-undef": "warn",
    "no-unused-vars": "warn",
    "no-constant-condition": "warn",
    "no-prototype-builtins": "off",
    "no-empty": "warn",
    "no-useless-escape": "off",
    "no-redeclare": "off",
    "no-inner-declarations": "off"
  },
  "globals": {
    "localforage": "readonly",
    "JSZip": "readonly",
    "Dexie": "readonly",
    "escapeHTML": "readonly",
    "showNotification": "writable",
    "showModal": "writable",
    "hideModal": "writable",
    "renderMessages": "writable",
    "updateUI": "writable",
    "throttledSaveData": "writable",
    "saveData": "writable",
    "loadData": "writable",
    "APP_PREFIX": "writable",
    "SESSION_ID": "writable",
    "DOMElements": "writable",
    "messages": "writable",
    "settings": "writable",
    "getStorageKey": "writable",
    "renderReplyLibrary": "writable",
    "optimizeImage": "writable",
