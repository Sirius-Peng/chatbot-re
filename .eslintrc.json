    "customIntros": "writable",
    "customEmojis": "writable",
    "stickerLibrary": "writable",
    "myStickerLibrary": "writable",
    "anniversaries": "writable",
    "partnerPersonas": "writable",
    "sessionList": "writable",
    "envelopeData": "writable",
